digraph "Game"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="Game",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Structure principale du jeu."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" plateformes" ];
  Node2 [label="ListePlateformes",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structListePlateformes.html",tooltip="Liste des plateformes."];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" p" ];
  Node3 [label="Plateforme",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structPlateforme.html",tooltip="Structure d'une plateforme."];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" segments" ];
  Node4 [label="Segment",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structSegment.html",tooltip="Structure contenant un background."];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" guide\nlevelGuide" ];
  Node5 [label="Guide",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structGuide.html",tooltip="Structure des guides affichés."];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" timer" ];
  Node6 [label="Timer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structTimer.html",tooltip="Structure du timer."];
}
